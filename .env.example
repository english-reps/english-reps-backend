# Local development only. Copy to .env; never commit actual credentials.
APP_ENV=development
POSTGRES_USER=english_reps
POSTGRES_PASSWORD=replace-with-a-long-local-password
POSTGRES_DB=english_reps
# URL-encode reserved characters if editing this URL.
DATABASE_URL=postgresql+asyncpg://english_reps:replace-with-a-long-local-password@db:5432/english_reps
ALLOWED_ORIGINS=["http://localhost:3007","http://localhost:8080"]
COOKIE_SECURE=false
SESSION_DAYS=14
FRONTEND_PATH=../english-reps-frontend
# Set a different WEB_PORT if 8080 is occupied, and update ALLOWED_ORIGINS to match.
WEB_PORT=8080
